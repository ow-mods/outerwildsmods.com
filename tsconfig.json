{
	"extends": "$app/tsconfig",
	"include": [
		"src",
		"test",
		"*"
	],
	"exclude": [
		"src/service-worker"
	],
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"noImplicitAny": true,
		"noEmit": true,
		"paths": {
			"#lib": [
				"./src/lib"
			],
			"#lib/*": [
				"./src/lib/*"
			]
		}
	}
}
